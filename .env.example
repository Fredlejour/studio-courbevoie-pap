# Configuration des variables d'environnement
# Copier ce fichier vers .env.local et remplir les valeurs sensibles.

# Clé d'accès Web3Forms (https://web3forms.com/)
NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=votre-cle-web3forms-ici

# URL canonique du site (utilisée pour les métadonnées et les liens)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Identifiant Google Analytics 4 (optionnel)
NEXT_PUBLIC_GA_ID=

# Token Google Search Console (optionnel, peut aussi être intégré via metadata.verification)
NEXT_PUBLIC_GSC_TOKEN=
